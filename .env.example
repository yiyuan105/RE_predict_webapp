# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已在 .gitignore 与 .dockerignore 中排除，不要提交真实密钥。

# 线上必须为 false（容器里由 compose 再次兜底设置）
DJANGO_DEBUG=false

# 必须替换：python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=请替换为随机长字符串

# 逗号分隔；部署后填实际域名与服务器 IP
DJANGO_ALLOWED_HOSTS=ecofluxforecast.cn,www.ecofluxforecast.cn,8.133.180.65,127.0.0.1

# 用 https 域名访问后台或提交表单时填写，逗号分隔
DJANGO_CSRF_TRUSTED_ORIGINS=https://ecofluxforecast.cn,https://www.ecofluxforecast.cn

# 同时缓存的随机森林模型数量（每个约 20MB），内存紧张时调小
RF_MODEL_CACHE_SIZE=4

# 气象数据源：留空即 Open-Meteo best_match；历史回算可用 historical-forecast-api
WEATHER_ENDPOINT=https://api.open-meteo.com/v1/forecast
WEATHER_MODEL=
WEATHER_TIMEOUT_SECONDS=20
WEATHER_FORECAST_DAYS=1
